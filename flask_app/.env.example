# Copy this file to ".env" and fill in your own values.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:        cp .env.example .env
#
# The app runs fine with an EMPTY .env -- it will start, just with reduced
# features. Nothing here is mandatory for local development.

# Signs the session cookie that keeps you logged in. If you leave this blank the
# app prints a warning and generates a throwaway key at startup, which means
# you get logged out every time you restart. Any long random string works:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional -- https://newsapi.org  (free tier: 100 requests/day, then HTTP 429)
# Without it the live feed falls back to Google News RSS, which needs no key.
NEWS_API_KEY=

# Optional -- https://aistudio.google.com/apikey
# Without it the fake-news checker falls back to the web-coverage verdict,
# which is weaker but still functional.
GEMINI_API_KEY=

# Leave as "development" for local runs. Do NOT set this to production on your
# own machine: in production the app refuses to start unless SECRET_KEY is set.
FLASK_ENV=development

# Optional. Only needed if you move the large data files
# (cleaned_data_with_fake_news.csv, similarity_table.csv, tfidf_vectorizer.pkl,
# tfidf_matrix.npz) somewhere other than this folder. Point it at that folder.
# DATA_DIR=C:\some\other\folder